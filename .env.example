# ===========================================
# AppDock Environment Configuration
# ===========================================
# Copy this file to .env and modify as needed
# cp .env.example .env

# ===========================================
# Server Configuration
# ===========================================

# Port for the backend server (default: 3000)
PORT=8080

# Path to static files for production (default: ./static)
# Leave empty or remove for API-only mode
STATIC_PATH=./static

# ===========================================
# Authentication Configuration
# ===========================================

# Username for login (default: admin)
APPDOCK_USERNAME=admin

# Password for login (default: appdock)
# IMPORTANT: Change this in production!
APPDOCK_PASSWORD=appdock

# JWT secret key for token signing (default: appdock-secret-key-change-in-production)
# IMPORTANT: Use a strong random string in production!
# Generate with: openssl rand -hex 32
APPDOCK_JWT_SECRET=your-super-secret-key-change-in-production

# Disable authentication (default: false)
# Set to "true" to bypass authentication entirely (NOT recommended for production)
APPDOCK_AUTH_DISABLED=false

# WebSocket browser origins (comma-separated). Empty = dev defaults + same Host as request.
# Example production UI at https://dock.example.com:
# APPDOCK_WS_ALLOWED_ORIGINS=https://dock.example.com
# APPDOCK_WS_ALLOW_INSECURE_ORIGINS=true  # allow any Origin (debug only; do not use in prod)

# ===========================================
# Docker Configuration (optional)
# ===========================================

# Docker host (default: uses local Docker socket)
# Uncomment to connect to remote Docker host
# DOCKER_HOST=tcp://localhost:2375

# ===========================================
# Frontend Configuration (for development)
# ===========================================

# API base URL (used by Vite proxy in development)
# VITE_API_URL=http://localhost:3000

# ===========================================
# Security monitoring (Gemini + network heuristics)
# ===========================================

# Google AI Studio / Gemini API key (also accepts GOOGLE_AI_API_KEY)
# GEMINI_API_KEY=

# Model name for generateContent (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Background scan interval in seconds (default: 300)
# APPDOCK_SECURITY_SCAN_INTERVAL=300

# Minimum severity to persist automated reports: info|low|medium|high|critical (default: medium)
# APPDOCK_SECURITY_REPORT_MIN_SEVERITY=medium

# Seconds between Gemini calls per server for scheduled scans (default: 600)
# APPDOCK_SECURITY_AI_COOLDOWN_SEC=600

# Set to false to disable outbound AI calls (heuristics only)
# APPDOCK_SECURITY_AI_ENABLED=true
